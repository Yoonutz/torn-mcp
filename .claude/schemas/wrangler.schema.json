{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wrangler.toml (torn-mcp Worker)",
  "description": "Pinned to the code and to two decisions recorded in the file: the Durable Object bindings src/ uses (MCP_OBJECT -> TornMCP, RATE_LIMITER -> RateLimiter); SQLite-backed classes only (the Free plan requires it, so new_classes is refused); and invocation logs off, so an API key a client puts in a URL is never persisted. No secret may be a plain var.",
  "type": "object",
  "required": ["name", "main", "compatibility_date", "durable_objects", "migrations", "observability"],
  "properties": {
    "name": { "const": "torn-mcp" },
    "main": { "type": "string", "minLength": 1 },
    "compatibility_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "compatibility_flags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "durable_objects": {
      "type": "object",
      "required": ["bindings"],
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["name", "class_name"],
            "additionalProperties": false,
            "properties": {
              "name": { "enum": ["MCP_OBJECT", "RATE_LIMITER"] },
              "class_name": { "enum": ["TornMCP", "RateLimiter"] },
              "script_name": { "type": "string" }
            },
            "anyOf": [
              { "properties": { "name": { "const": "MCP_OBJECT" }, "class_name": { "const": "TornMCP" } } },
              { "properties": { "name": { "const": "RATE_LIMITER" }, "class_name": { "const": "RateLimiter" } } }
            ]
          }
        }
      }
    },
    "migrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tag"],
        "additionalProperties": false,
        "properties": {
          "tag": { "type": "string", "minLength": 1 },
          "new_sqlite_classes": { "type": "array", "items": { "type": "string" } },
          "renamed_classes": { "type": "array" },
          "deleted_classes": { "type": "array", "items": { "type": "string" } },
          "new_classes": false
        }
      }
    },
    "observability": {
      "type": "object",
      "required": ["logs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "logs": {
          "type": "object",
          "required": ["invocation_logs"],
          "properties": { "invocation_logs": { "const": false } }
        }
      }
    },
    "vars": {
      "type": "object",
      "properties": { "TORN_API_KEY": false }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern"],
        "additionalProperties": false,
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "zone_name": { "type": "string" },
          "zone_id": { "type": "string" },
          "custom_domain": { "type": "boolean" }
        }
      }
    }
  }
}
